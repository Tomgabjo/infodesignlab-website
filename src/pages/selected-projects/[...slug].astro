---
/**
 * Abstract / article template. Per the approved template mapping this one
 * covers all 17 case studies and postings — it is not abstract-specific; the
 * content-type label in the left rail is what varies.
 *
 * Route lives at /selected-projects/<slug>/ deliberately: that is the existing
 * Squarespace path, so inbound links and search results survive the migration.
 * astro.config.mjs sets build.format:"directory" for the same reason.
 *
 * Asymmetric editorial grid (layout.css): left rail = content-type label and
 * mono metadata, right = title and body.
 */
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import WorkGrid from "../../components/WorkGrid.astro";
import Figure from "../../components/Figure.astro";
import Figures from "../../components/Figures.astro";

export const getStaticPaths = (async () => {
  // Stubs are listed in the work grid but have no page yet, so they get no route.
  const entries = await getCollection(
    "caseStudies",
    ({ data }) => !data.draft && !data.stub
  );
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { title, label, summary, venue, authors, design, references, cover } =
  entry.data;

// Made available to MDX bodies so a figure can sit between the paragraphs it
// belongs to. Any component used in an .mdx body MUST be listed in this map,
// or the build fails with "Expected component X to be defined".
const mdxComponents = { Figure, Figures };

// Open Graph needs a URL string. A migrated cover is an imported image object,
// whose .src is the built asset path; a stub cover is already a URL.
const ogImage = typeof cover === "string" ? cover : cover?.src;

const { Content } = await render(entry);
---

<Base title={`${title} — InfoDesignLab`} description={summary} image={ogImage}>
  <main class="wrap">
    <header class="head">
      <div class="head__label">{label}</div>
      <h1 class="head__title">{title}</h1>
    </header>

    <div class="body">
      <aside class="meta">
        {
          venue && (
            <div class="meta__block">
              <strong>↳ {venue.label}</strong>
              {venue.value}
            </div>
          )
        }

        {
          authors.length > 0 && (
            <div class="meta__block">
              <strong>↳ {authors.length === 1 ? "Author" : "Authors"}</strong>
              {
                // Name and each affiliation are separate blocks, so entries run
                // on consecutive lines with no blank line between them.
                authors.map((a) => (
                  <>
                    <span class="who">{a.name}</span>
                    {a.affiliations.map((aff) => <span class="aff">{aff}</span>)}
                  </>
                ))
              }
            </div>
          )
        }

        {
          design.length > 0 && (
            <div class="meta__block">
              <strong>↳ Design</strong>
              {design.map((d) => <span class="who">{d}</span>)}
            </div>
          )
        }

        {
          references.length > 0 && (
            <div class="meta__block meta__refs">
              <strong>↳ References</strong>
              <ul>
                {
                  references.map((r) => (
                    <li>
                      {r.text}
                      {
                        r.href && (
                          <>
                            {" "}
                            <a href={r.href} target="_blank" rel="noopener noreferrer">
                              {r.href.replace(/^https?:\/\//, "")}
                            </a>
                          </>
                        )
                      }
                    </li>
                  ))
                }
              </ul>
            </div>
          )
        }
      </aside>

      <div class="copy">
        <Content components={mdxComponents} />
      </div>
    </div>

    <WorkGrid
      heading="All work"
      moreHref="/selected-projects/"
      moreText="Back to overview →"
      currentId={entry.id}
    />
  </main>
</Base>
