---
/**
 * A real portfolio figure, aligned to the text column, caption sitting below
 * the image. No borders and no grey gutters — figures sit on white, per the
 * design system, and the graph itself is the focus.
 *
 * Accepts either:
 *   - an imported local image (ImageMetadata) — goes through Astro/sharp,
 *     emitting a responsive srcset. Used for hero reel images in src/assets/hero/.
 *   - a plain URL string like "/images/slug/00-img.jpg" — served via the
 *     Netlify Image CDN for on-demand resize and AVIF/WebP negotiation.
 *     All migrated portfolio images now live in public/images/ and use this path.
 *
 * Available inside MDX bodies so a figure can sit between the paragraphs it
 * belongs to, rather than being pushed into frontmatter.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  /** Caption as published. Never rewritten during migration. */
  caption?: string;
  /** Hint for srcset selection; figures span the text column, not the viewport. */
  sizes?: string;
}

const {
  src,
  alt,
  caption,
  sizes = "(max-width: 900px) 100vw, 60vw",
} = Astro.props;

const isLocal = typeof src !== "string";

function netlifyImg(path: string, w: number) {
  return `/.netlify/images?url=${encodeURIComponent(path)}&w=${w}`;
}

const strSrc = isLocal ? "" : (src as string);
const cdnWidths = [400, 800, 1200, 1800];
---

<figure class="fig">
  {
    isLocal ? (
      <Image
        src={src as ImageMetadata}
        alt={alt}
        sizes={sizes}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <img
        src={netlifyImg(strSrc, 1200)}
        srcset={cdnWidths.map((w) => `${netlifyImg(strSrc, w)} ${w}w`).join(", ")}
        sizes={sizes}
        alt={alt}
        loading="lazy"
        decoding="async"
      />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>
