---
/**
 * The one layout every page uses: head, persistent chrome, content slot, footer.
 *
 * STYLESHEET ORDER IS LOAD-BEARING — tokens must come first, since every later
 * sheet reads var(--*) from it:
 *   tokens     design system values, the single source of truth
 *   base       resets and element defaults
 *   chrome     logo, menu button, Table of contents panel, footer
 *   layout     split screen, media panel, columns, inner-page grid
 *   components work rows, plugs, events, quote, ticker, cards, caps, figures
 * Imported here rather than per-page so Astro bundles one stylesheet.
 */
import SiteHead from "../components/SiteHead.astro";
import Logo from "../components/Logo.astro";
import TableOfContentsMenu from "../components/TableOfContentsMenu.astro";
import Footer from "../components/Footer.astro";

import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/chrome.css";
import "../styles/layout.css";
import "../styles/components.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const { title, description, image, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={title} description={description} image={image} noindex={noindex} />
  </head>
  <body id="top">
    <Logo />
    <TableOfContentsMenu />
    <slot />
    <Footer />
  </body>
</html>
